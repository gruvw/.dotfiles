" ~/.config/vifm/colors/main.vifm

" Available attributes (some of them can be combined):
" bold
" underline
" reverse or inverse
" standout
" italic (on unsupported systems becomes reverse)
" none

" highlight group cterm=attrs ctermfg=foreground_color ctermbg=background_color

highlight clear

" UI
highlight Win         guibg=#1F1F1F guifg=white   cterm=none ctermfg=white ctermbg=black
highlight Border      guibg=#1F1F1F guifg=#1F1F1F cterm=none ctermfg=black ctermbg=black
highlight CmdLine     guibg=#1F1F1F guifg=white   cterm=none ctermfg=white ctermbg=black
highlight TopLine     guibg=#1F1F1F guifg=white   cterm=none ctermfg=cyan  ctermbg=black
highlight TopLineSel  guibg=cyan    guifg=#1F1F1F cterm=bold ctermfg=black ctermbg=cyan  gui=bold
highlight StatusLine  guibg=green   guifg=#1F1F1F cterm=bold ctermfg=black ctermbg=green gui=bold
highlight WildMenu    guibg=white   guifg=#1F1F1F cterm=none ctermfg=black ctermbg=white
highlight ErrorMsg    guibg=red     guifg=#1F1F1F cterm=none ctermfg=black ctermbg=red
highlight Selected    guibg=blue    guifg=#1F1F1F ctermfg=black ctermbg=blue
highlight CurrLine    cterm=reverse,bold gui=reverse,bold

" Files
highlight Directory   ctermfg=green   cterm=bold
highlight Link        ctermfg=yellow  cterm=italic
highlight BrokenLink  ctermfg=red     cterm=italic
highlight Executable  ctermfg=blue    cterm=bold
highlight Socket      ctermfg=magenta cterm=bold
highlight Device      ctermfg=red     cterm=bold
highlight Fifo        ctermfg=cyan    cterm=bold


" highlight Selected cterm=bold ctermfg=magenta ctermbg=red
" highlight JobLine cterm=bold,reverse ctermfg=black ctermbg=white
" highlight SuggestBox cterm=bold ctermfg=default ctermbg=default
" highlight CmpMismatch cterm=bold ctermfg=white ctermbg=red
" highlight AuxWin cterm=bold,underline,reverse,standout,italic ctermfg=default ctermbg=default
" highlight TabLine cterm=none ctermfg=white ctermbg=black
" highlight TabLineSel cterm=bold,reverse ctermfg=default ctermbg=default
" highlight OtherWin cterm=bold,underline,reverse,standout,italic ctermfg=default ctermbg=default
