// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "temperature",
        "cpu",
        "memory",
        "backlight",
        "pulseaudio",
        "network",
        "tray",
        "battery",
    ],
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "0",
            "2": "1",
            "3": "2",
            "4": "3",
            "5": "4",
            "6": "5",
            "7": "6",
            "8": "7",
            "9": "8",
            "10": "9",
            "11": "10",
            "12": "11",
            "default": "{index}" ,
        },
    },
    "clock": {
        "format": "{:%Y_%m_%d %a %H:%M:%S}",
        "interval": 1,
        "tooltip": false,
        "on-click": "niri msg action spawn -- xdg-open https://calendar.google.com/",
    },
    "tray": {
        "spacing": 6,
    },
    "cpu": {
        "format": "{avg_frequency:.2f}GHz {usage}%",
        "interval": 2,
        "tooltip": false,
        "states": {
            "warning": 50,
            "critical": 90,
        },
    },
    "memory": {
        "format": "{used:0.2f}GB",
        "interval": 2,
        "tooltip-format": "{used:0.1f}GB/{total:0.1f}GB {percentage}%",
        "states": {
            "warning": 40,
            "critical": 70,
        },
    },
    "temperature": {
        "format": "{temperatureC}°C",
        "format-critical": "{temperatureC}°C {icon}",
        "interval": 2,
        "tooltip": false,
        "warning-threshold": 70,
        "critical-threshold": 80,
    },
    "backlight": {
        "format": "{icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": false,
    },
    "battery": {
        "interval": 10,
        "format": "{time} {capacity}%",
        "format-critical": "{time} 󰂎 {capacity}%",
        "format-charging": "{time} 󰢜 {capacity}%",
        "format-full": "󰂅 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-time": "{H}:{m}",
        "states": {
            "warning": 30,
            "critical": 15,
        },
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "󰯡",
        "tooltip-format": "{ifname}: {essid} {signalStrength}% ({signaldBm}dBm)\n{ipaddr}/{cidr} via {gwaddr}\nD{bandwidthDownBytes} U{bandwidthUpBytes}",
        "interval": 3,
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click": "nm-connection-editor",
    },
    "pulseaudio": {
        "format": "{format_source}  <span color='#FC9A69'>{icon}</span>",
        "format-muted":  "{format_source}  ",
        "format-bluetooth": "{format_source}   <span color='#FC9A69'>{icon}</span>",
        "format-bluetooth-muted": "{format_source}   ",
        "format-source": "<span color='#FC9A69'></span>",
        "format-source-muted": "",
        "format-icons": {
            "default": ["", "", ""],
            "headphone": [" ", " ", "  "],
            "hands-free": [" ", " ", "  "],
            "headset": [" ", " ", "  "],
            "phone": [" ", " ", "  "],
            "portable": [" ", " ", "  "],
            "car": [" ", " ", "  "],
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "",
        "on-scroll-down": "",
    },
}
